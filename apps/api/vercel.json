{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && node scripts/copy-vendor.js",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{node_modules/.prisma/client/**,vendor/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
