{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/{.prisma/client,@sparticuz/chromium/bin,docx-preview/dist,jszip/dist}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
